# Copy this file to .env and fill in your own values.
# Use a dedicated API key with READ-ONLY permission only.
# Do NOT enable Futures trading, withdrawals, or transfers.
BINANCE_API_KEY=put_your_api_key_here
BINANCE_API_SECRET=put_your_api_secret_here

BINANCE_REST_BASE=https://fapi.binance.com
BINANCE_WS_BASE=wss://fstream.binance.com/private
PORT=6092
BTCUSDC_ONLY=false
